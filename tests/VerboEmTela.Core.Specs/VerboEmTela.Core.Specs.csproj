<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Exe</OutputType>
    <AssemblyName>VerboEmTela.Core.Specs</AssemblyName>
    <RootNamespace>VerboEmTela.Core.Specs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/VerboEmTela.Core/VerboEmTela.Core.csproj" />
    <ProjectReference Include="../../src/VerboEmTela.Ocr.Tesseract/VerboEmTela.Ocr.Tesseract.csproj" />
    <ProjectReference Include="../../src/VerboEmTela.Windows/VerboEmTela.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../evidence/video-evidence.v1.json"
             Link="Evidence/video-evidence.v1.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../evidence/video-layout-evidence.v1.json"
             Link="Evidence/video-layout-evidence.v1.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/VerboEmTela.Ocr.Tesseract/tessdata/por.traineddata"
             Link="tessdata/por.traineddata"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/VerboEmTela.Ocr.Tesseract/tessdata/LICENSE"
             Link="tessdata/LICENSE"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/VerboEmTela.Ocr.Tesseract/ocr-components.v1.json"
             Link="ocr-components.v1.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
